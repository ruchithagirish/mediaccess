DATABASE_URL="postgresql://mediaccess:mediaccess@localhost:5432/mediaccess?schema=public"
REDIS_URL=redis://localhost:6379
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Must be identical to JWT_ACCESS_SECRET in web/.env.local (the Next.js middleware verifies the token).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
DEFAULT_TENANT_SLUG=demo
NODE_ENV=development

# Optional Razorpay checkout and webhook verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMTP payment receipts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WhatsApp Cloud API payment receipts
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_RECEIPT_TEMPLATE=payment_receipt
WHATSAPP_RECEIPT_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_APPOINTMENT_TEMPLATE=
WHATSAPP_APPOINTMENT_LANGUAGE=en

# Optional MSG91 phone verification and appointment SMS (approved templates required)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_APPOINTMENT_TEMPLATE_ID=

# Optional prescription integrity-signing key (defaults to JWT_ACCESS_SECRET)
PRESCRIPTION_SIGNING_SECRET=

# Optional S3-compatible investigation report storage
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional for LocalStack/MinIO; omit for AWS S3
S3_ENDPOINT=

# Optional electronic prescription signature key (defaults to JWT_ACCESS_SECRET)
PRESCRIPTION_SIGNING_SECRET=

# Optional S3-compatible report storage
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional for LocalStack/MinIO; leave empty for AWS S3
S3_ENDPOINT=

# Optional report-ready and critical-result email notifications use SMTP settings above
